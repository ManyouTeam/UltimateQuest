# Maven build output
target/

# Binary dependencies are provided locally and are not published
*.jar
*.lastUpdated

# IntelliJ IDEA project-local files
.idea/
*.iml
*.ipr
*.iws

# Eclipse project-local files
.classpath
.project
.settings/

# Build and runtime logs
*.log
hs_err_pid*
replay_pid*

# Python cache generated by maintenance scripts
__pycache__/
*.py[cod]

# Maven helper/plugin output
.flattened-pom.xml
dependency-reduced-pom.xml
pom.xml.versionsBackup
.mvn/timing.properties

# Local environment and operating-system files
.env
.env.*
!.env.example
.DS_Store
Thumbs.db
Desktop.ini

# Public resources and placeholders for private default configurations
/plugin/src/main/resources/*
!/plugin/src/main/resources/config.yml
!/plugin/src/main/resources/plugin.yml
!/plugin/src/main/resources/paper-plugin.yml
!/plugin/src/main/resources/languages/
!/plugin/src/main/resources/menus/
!/plugin/src/main/resources/quests/
!/plugin/src/main/resources/tasks/
!/plugin/src/main/resources/categories/
!/plugin/src/main/resources/battlepasses/
!/plugin/src/main/resources/milestones/
!/plugin/src/main/resources/pools/
!/plugin/src/main/resources/reward-pools/
!/plugin/src/main/resources/periods/
!/plugin/src/main/resources/scrolls/
!/plugin/src/main/resources/items/

# Local development tools and private configuration migration data
/.buildtools/
/.workbuddy/

# Local-only tests and maintenance artifacts
**/src/test/
/MODIFICATION_REPORT.md
/tools/

# Local validation suites and captured command output
/validation/
/check-out.txt
/check-err.txt
